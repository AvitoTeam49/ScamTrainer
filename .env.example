# Скопировать в .env и заполнить перед `docker compose up`.

# Обязательные
JWT_SECRET=
DEEPSEEK_API_KEY=

# Порт, на котором nginx отдаёт фронт и проксирует /api
FRONTEND_PORT=80

# Postgres
POSTGRES_USER=scamtrainer
POSTGRES_PASSWORD=scamtrainer
POSTGRES_DB=scamtrainer

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
